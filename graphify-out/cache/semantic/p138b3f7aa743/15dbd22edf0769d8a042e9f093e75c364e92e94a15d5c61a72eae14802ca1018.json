{"nodes": [{"id": "traffic_light_revamped_implementation_status_doc", "label": "Traffic Simulation Engine Implementation Status", "file_type": "document", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_phase1_vehicle_trip_generator", "label": "Phase 1: Vehicle Trip Generator", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_phase2_core_cpp_engine", "label": "Phase 2: Core C++ Headless Engine", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_intelligent_driver_model", "label": "Intelligent Driver Model (IDM) car-following", "file_type": "rationale", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tuned 'selfish' (tighter headway, higher accel) so vehicles don't wait unless they have to."}, {"id": "traffic_light_revamped_implementation_status_lane_commitment_lookahead", "label": "Lane-commitment lookahead (desiredLaneForStep)", "file_type": "rationale", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Looking ahead through the whole approach chain lets turning vehicles commit early, fixing artificial single-file traffic near junctions."}, {"id": "traffic_light_revamped_implementation_status_junction_conflict_compatibility", "label": "Junction conflict compatibility (movementsCompatible)", "file_type": "rationale", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L59,L693", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conservative flow-channel approximation rather than full conflict-point geometry; opposite right turns allowed only when destination ways differ, after a chord-crossing test was found wrong."}, {"id": "traffic_light_revamped_implementation_status_edge_capacity_check", "label": "Hard edge-transition capacity check", "file_type": "rationale", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L752", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDM lookahead is advisory only; a hard floor on chain-to-chain and full junction-edge transitions eliminated same-point vehicle stacking (~44,600 to ~240 overlap pairs)."}, {"id": "traffic_light_revamped_implementation_status_phase3_websocket_streaming", "label": "Phase 3: WebSocket Streaming + Live Rendering", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-rolled WebSocket server with no external deps to match the project's g++ -static convention."}, {"id": "traffic_light_revamped_implementation_status_phase4_signal_control_modes", "label": "Phase 4: Signal-Control Modes", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_default_fixed_time_mode", "label": "Default fixed-time signal mode", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_density_mode", "label": "Density-based (red-dot weighted) signal mode", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approach weight = count of waiting vehicles + seconds waited; deliberately no fixed phase timer."}, {"id": "traffic_light_revamped_implementation_status_emergency_only_mode", "label": "Emergency-only preemption signal mode", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_emergency_preemption", "label": "Emergency preemption (lead-time / grace / clearing)", "file_type": "rationale", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L146-283", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reactive front-of-queue preemption was too late; replaced with route-lookahead ETA trigger (PREEMPT_LEAD_SEC 10s), grace release (PREEMPT_GRACE_SEC 5s), a 5s yellow Clearing window, own-approach forced open, only conflicting approaches forced red, and lapse for stuck vehicles."}, {"id": "traffic_light_revamped_implementation_status_redlightcontroller_reportemergency", "label": "RedlightController::reportEmergency (holdUntilSimClock)", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L162", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_phase5_emergency_incident_system", "label": "Phase 5: Emergency Incident System", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L285", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_emergency_flag", "label": "Vehicle emergency flag / emergencyPhase (em/ep)", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L294,L405", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flag deliberately separate from vehicleType so non-dispatched emergency-capable vehicles get no priority."}, {"id": "traffic_light_revamped_implementation_status_dispatch_incident_command", "label": "dispatchIncident command", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L325", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranks by straight-line distance, not route cost; CH query per candidate judged not worth it for rare events."}, {"id": "traffic_light_revamped_implementation_status_cancel_emergency_command", "label": "cancelEmergency (Recall) command", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L424", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "traffic_light_revamped_implementation_status_incident_preset_ui", "label": "Incident-preset Emergency Control UI", "file_type": "concept", "source_file": "traffic light revamped/IMPLEMENTATION_STATUS.md", "source_location": "L335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-contained cards per incident avoid inspector click friction; timer keyed to sim clock so cadence scales with fast-forward; live editable cards never rebuilt on a timer."}, {"id": "traffic_light_revamped_implementation_status_emergency_depots", "label": "Emergency vehicle depots (hospital/fire/police)", "file_type": "co